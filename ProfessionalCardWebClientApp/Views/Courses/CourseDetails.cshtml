@page "/Courses/Details/{id:int}"
@model CourseDetailsModel

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Детали курса</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h1>@Model.Course.Name</h1>
        <p><strong>Описание:</strong> @Model.Course.Description</p>
        <p><strong>Навыки и компетенции:</strong> @Model.Course.Skills</p>
        <p><strong>Длительность:</strong> @Model.Course.Duration</p>
        <p><strong>Стоимость:</strong> @Model.Course.Price</p>
        <a href="@Model.Course.RegistrationLink" class="btn btn-primary" target="_blank">Перейти к регистрации</a>
        <a href="/CareerPath" class="btn btn-secondary mt-3">Вернуться к маршруту</a>
    </div>
</body>
</html>