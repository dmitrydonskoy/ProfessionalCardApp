@{
    ViewData["Title"] = "Карьерный маршрут";
}

<h1>Интерактивный карьерный маршрут</h1>

@{
    ViewData["Title"] = "Карьерный маршрут";
}
<form id="routeForm" method="post">
    <div class="mb-3">
        <label for="education" class="form-label">Ваша профессия</label>
        <input type="text" id="education" name="education" class="form-control" placeholder="Введите профессию, которую хотите освоить">
    </div>
    <div class="mb-3">
        <label for="skills" class="form-label">Ваши навыки</label>
        <input type="text" id="skills" name="skills" class="form-control" placeholder="Введите ваши навыки">
    </div>
    <div class="mb-3">
        <label for="interests" class="form-label">Навыки, которые хотите освоить</label>
        <input type="text" id="interests" name="interests" class="form-control" placeholder="Введите ваши интересы">
    </div>
    <button type="submit" class="btn btn-primary">Построить маршрут</button>
</form>
<div class="modal fade" id="nodeModal" tabindex="-1" role="dialog" aria-labelledby="nodeModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="nodeModalLabel">Детали узла</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times</span>
                </button>
            </div>
            <div class="modal-body">
                <h5 id="modalNodeLabel"></h5>
                <p id="modalNodeDescription"></p>
                <div id="modalNodeLinks"> </div>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">Перейти к курсу</span>
                </button>
            </div>
            
        </div>
    </div>
</div>

<!-- Граф -->
<section id="graphContainer" class="mt-5">
    <h2>Маршрут профессионального развития</h2>
    <div id="careerGraph" style="width: 100%; height: 500px; border: 1px solid #ccc;"></div>
</section>
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cytoscape/3.24.0/cytoscape.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qtip2/3.0.3/jquery.qtip.min.js"></script>
<script src="https://unpkg.com/cytoscape-qtip/cytoscape-qtip.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/qtip2/3.0.3/jquery.qtip.min.css" />
<script>
    // Демонстрационные данные
   

    // Функция для построения графа
    function buildGraph(data) {
        const cy = cytoscape({
            container: document.getElementById('careerGraph'),
            elements: [...data.nodes, ...data.edges],
            style: [
                {
                    selector: 'node',
                    style: {
                        'background-color': '#007bff',
                        'label': 'data(label)',
                        'color': '#fff',
                        'text-valign': 'center',
                        'text-halign': 'center',
                        'font-size': '14px',
                        'font-weight': 'bold',
                        'shape': 'round-rectangle',
                        'padding': '10px',
                        'width': 'label',
                        'height': 'label',
                        'border-width': '2px',
                        'border-color': '#0056b3',
                        'text-wrap': 'wrap',
                        'text-max-width': '120px'
                    }
                },
                {
                    selector: 'edge',
                    style: {
                        'width': 3,
                        'line-color': '#0056b3',
                        'target-arrow-color': '#0056b3',
                        'target-arrow-shape': 'triangle',
                        'curve-style': 'bezier'
                    }
                }
            ],
            layout: {
                name: 'breadthfirst',
                directed: true,
                padding: 20
            }
        });

        cy.on('tap', 'node', function (evt) {
            const node = evt.target;
            const label = node.data('label');
            const description = node.data('description') || 'Описание курса: Курс';
            const links = node.data('links') || ['https://skillbox.ru/media/code/thymeleaf-dlya-novichkov-ozhivlyaem-htmlshablony/'];

            document.getElementById('modalNodeLabel').innerText = label;
            document.getElementById('modalNodeDescription').innerText = description;

            const linksContainer = document.getElementById('modalNodeLinks');
            linksContainer.innerHTML = '';
            links.forEach(link => {
                const a = document.createElement('a');
                a.href = link.url;
                a.target = '_blank';
                a.innerText = 'Отметить, как выполненное';
                a.classList.add('btn', 'btn-primary', 'btn-sm', 'mr-2', 'mt-2');
                linksContainer.appendChild(a);
            });

            $('#nodeModal').modal('show');
        });
    }

    // Построить демонстрационный граф при загрузке страницы
    document.addEventListener('DOMContentLoaded', () => {
        const demoData = {
            nodes: [
                { data: { id: "start", label: "Начальная точка", title: "Это отправная точка вашего маршрута" } },
                { data: { id: "course1", label: "Основы программирования", title: "Курс, который познакомит вас с базовыми навыками программирования" } },
                { data: { id: "course2", label: "Frontend-разработка", title: "Курс по созданию веб-интерфейсов" } },
                { data: { id: "job1", label: "Junior-разработчик", title: "Первая работа в IT" } },
                { data: { id: "course3", label: "Алгоритмы", title: "Курс, углубляющий знания в алгоритмах" } },
                { data: { id: "job2", label: "Middle-разработчик", title: "Уровень профессионала с опытом" } },
                { data: { id: "expert", label: "Senior-разработчик", title: "Эксперт в разработке" } }
            ],
            edges: [
                { data: { source: "start", target: "course1" } },
                { data: { source: "course1", target: "course2" } },
                { data: { source: "course2", target: "job1" } },
                { data: { source: "job1", target: "course3" } },
                { data: { source: "course3", target: "job2" } },
                { data: { source: "job2", target: "expert" } }
            ]
        };

        buildGraph(demoData);
    });
</script>

<!-- Подключение библиотеки qTip -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qtip2/3.0.3/jquery.qtip.min.js"></script>
